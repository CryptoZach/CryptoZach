{
  "name": "cryptozach-site",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:responsive": "node scripts/check-responsive.js",
    "build:home-stats": "python3 scripts/render_home_stats.py --write",
    "build:letter-count": "python3 scripts/render_letter_count.py --write",
    "build:patent-count": "python3 scripts/check_patent_count.py --write",
    "build:commit-chart": "python3 scripts/render_commit_chart.py --write --refresh",
    "check:commit-chart": "python3 scripts/render_commit_chart.py --check",
    "sync:counts": "python3 scripts/render_letters.py --write && python3 scripts/render_letter_count.py --write && python3 scripts/check_patent_count.py --write && python3 scripts/render_commit_chart.py --write --refresh && python3 scripts/build_letters_pdf.py && python3 scripts/update_sitemap_lastmod.py",
    "map:counts": "python3 scripts/check_letter_count.py --map && python3 scripts/check_patent_count.py --map",
    "build:chrome": "python3 scripts/render_chrome.py --write",
    "build:brand": "python3 scripts/render_brand.py --write && python3 scripts/render_chrome.py --write",
    "check:brand": "python3 scripts/render_brand.py --check",
    "check:chrome": "python3 scripts/render_chrome.py --check",
    "build:letters": "python3 scripts/render_letters.py --write",
    "check:letters": "python3 scripts/render_letters.py --check",
    "build:letters-pdf": "python3 scripts/build_letters_pdf.py",
    "build:notes": "python3 scripts/render_notes.py --write",
    "check:notes": "python3 scripts/render_notes.py --check",
    "build:mvep": "python3 scripts/render_mvep_scorecard.py --write",
    "check:mvep": "python3 scripts/render_mvep_scorecard.py --check",
    "check:site-numbers": "python3 scripts/render_home_stats.py --check && python3 scripts/render_letter_count.py --check && python3 scripts/check_letter_count.py && python3 scripts/check_patent_count.py && python3 scripts/check_paper_count.py && python3 scripts/check_scale_figures.py && python3 scripts/render_commit_chart.py --check && python3 scripts/render_letters.py --check && python3 scripts/render_notes.py --check && python3 scripts/render_mvep_scorecard.py --check",
    "build:matrix-icons": "node scripts/build-matrix-icons.mjs",
    "build:purge-css": "purgecss --config purgecss.config.cjs",
    "build:minify-css": "cleancss -o _site/styles.css _site/styles.css && cleancss -o _site/vault.css _site/vault.css",
    "build:minify-js": "terser _site/script.js -o _site/script.js --compress --mangle && terser _site/home.js -o _site/home.js --compress --mangle",
    "build:minify-html": "html-minifier-terser --input-dir _site --output-dir _site --file-ext html --collapse-whitespace --remove-comments --remove-optional-tags --remove-redundant-attributes --remove-script-type-attributes --remove-style-link-type-attributes --use-short-doctype --minify-css true --minify-js true",
    "build:critical-css": "node scripts/inline-critical-css.mjs",
    "lint:css": "stylelint \"styles.css\" \"homepage.css\"",
    "build:wrap-terms": "node scripts/wrap-terms-build.mjs",
    "build:cache-bust-images": "node scripts/cache-bust-images.mjs _site",
    "build:postprocess": "npm run build:wrap-terms && npm run build:minify-css && npm run build:minify-js && npm run build:critical-css && npm run build:minify-html && npm run build:cache-bust-images",
    "build:postprocess:with-purgecss": "npm run build:wrap-terms && npm run build:purge-css && npm run build:minify-css && npm run build:minify-js && npm run build:critical-css && npm run build:minify-html && npm run build:cache-bust-images",
    "ci:postprocess:ci": "npm run build:postprocess",
    "build:homepage-logos": "python3 scripts/sync_homepage_matrix_logos.py --write",
    "check:homepage-logos": "python3 scripts/sync_homepage_matrix_logos.py --check && node scripts/check_homepage_matrix.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "beasties": "^0.4.2",
    "cheerio": "^1.2.0",
    "clean-css-cli": "^5.6.3",
    "html-minifier-terser": "^7.2.0",
    "playwright-core": "^1.59.1",
    "purgecss": "^6.0.0",
    "stylelint": "^16.26.1",
    "terser": "^5.36.0"
  }
}
