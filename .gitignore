__pycache__/
*.pyc
*.pyo
.DS_Store
__MACOSX/
*.egg-info/
.env
.venv/
*.log

node_modules/
test-results/
playwright-report/
playwright/.cache/
.playwright-mcp/

# Jekyll build output
_site/

# Ruby bundler artifacts. Gemfile.lock is gitignored because the
# github-pages gem pins transitive deps tightly; lock-file churn in CI
# is noisy without correctness benefit. bundler-cache in the GHA
# workflow + the github-pages pin in Gemfile deliver reproducible
# builds without committing the lock.
Gemfile.lock
.bundle/
vendor/bundle/

# Stale brand logos and working zips at repo root.
# Root-only ignore by extension (the leading slash anchors to repo root,
# so subdirectories like Publication-Images/, icons/, etc. are unaffected).
/*.svg
/*.png
/*.webp
/*.jpeg
/*.jpg
/*.zip

# Whitelist root-level images that must stay at repo root (referenced as
# absolute paths from the live site: favicon (browser tab) and
# apple-touch-icon).
!/apple-touch-icon.png
!/favicon.png
!/favicon.svg

# Defensive ignores added 2026-04-26 post-partition cleanup.
# Workflow content that re-accumulated in this site clone has been moved
# to the workflow clone (CryptoZach/Claude1) per partition logic. These
# patterns prevent re-accumulation in this site clone going forward.
.files/
scripts/.deps/
Cryptozach-site-files/

# Claude Code local settings (per-machine permissions, may contain API keys).
.claude/settings.local.json

# Auto-memory mirror: PRIVATE, Claude1 ONLY. Author directive 2026-08-14,
# "memory mirror shouldnt ever go to public repo, only private repo (Claude1)".
# This reverses the note that stood here until 2026-08-14, which described
# .claude/memory/ as "the git-tracked auto-memory backup" of THIS repo.
#
# THIS LINE IS THE WEAKER HALF, and it is written down so nobody mistakes it for
# the fix. gitignore does not apply to ALREADY-TRACKED files, and 41 of them are
# tracked here, so this line alone would stop new memory files and let every
# edit to those 41 through. The real enforcement is scripts/hooks/pre-commit,
# which now blocks any staged path under .claude/memory/ and defeats `git add -f`
# (verified 2026-08-14 by a live probe commit that was rejected).
#
# The 41 remain tracked and public at HEAD by author decision; removing them
# from HEAD would not unpublish them from history anyway.
.claude/memory/
