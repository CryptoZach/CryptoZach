#!/usr/bin/env bash
# Layer 2 site-clone safeguard against workflow-content commits per partition 2026-04-26.
# COMMITTED SOURCE (2026-06-24 cutover step 11): the body now lives in-repo at
# scripts/hooks/pre-commit and is installed into .git/hooks by
# scripts/install-site-hooks.sh, so a fresh clone is protected (it was
# previously local-only and stranded). Hard-reject; no env-var bypass (intentional).
# Per CLAUDE.md (post-partition; site-only orientation): workflow content lives
# in CryptoZach/Claude1 (clone at /Users/zach/Tokenization_Systems_Website/).
#
# 2026-04-27: .claude/memory/ exception (auto-memory mirror is tracked here).
#   RETIRED 2026-08-14 on author directive: "memory mirror shouldnt ever go to
#   public repo, only private repo (Claude1)". See the block below.
# 2026-06-24: AGENTS.md is NO LONGER blocked; the site clone now intentionally
# carries its own AGENTS.md (site-canonical rules + localhost-always) per the
# cross-clone cutover step 15.
#
# 2026-08-14: .claude/memory/ IS WORKFLOW CONTENT AND IS NOW BLOCKED HERE.
#
# THE EXCEPTION WAS GUARDING NOTHING, and that is why this needed a fix rather
# than a one-line deletion. `.claude/` never appeared in WORKFLOW_PATHS, so the
# `grep -vE '^\.claude/memory/'` filter below could never subtract anything: it
# was a no-op that READ like a deliberate carve-out. Measured 2026-08-14 with a
# positive control: '.claude/memory/foo.md' does not match WORKFLOW_PATHS while
# 'docs/x.md' does. So the guard had a HOLE, not an exception, and every routine
# site push carried the mirror to the PUBLIC repo. 41 files were public by
# 2026-08-05.
#
# WIDENED 2026-08-14 (second author directive, same day): ".claude/worktrees
# should not be in public repo, only claude1 private". The block is now ALL of
# `.claude/`, not a list of subdirectories, because enumerating them is a game
# you lose once: `.claude/memory/` and `.claude/worktrees/` were the only two
# tracked here, and a third would have ridden in silently exactly as these did.
# `.claude/settings.local.json` stays excluded by .gitignore as before.
#
# What `.claude/worktrees/97344` actually was, since the name suggests worse: a
# stray git worktree OF THIS SAME SITE REPO (same origin), committed by accident
# as an UNMAPPED GITLINK (mode 160000, no .gitmodules anywhere). So the public
# repo held a 40-char commit SHA and a directory name, never file content, since
# git does not push submodule objects. No workflow content leaked through it. It
# is session scratch that belongs in neither repo, so it is untracked here
# rather than moved to Claude1.
#
# WHAT THIS DOES AND DOES NOT DO. It stops FUTURE leakage, both new files and
# edits to anything already tracked under `.claude/`. It does NOT remove the 41
# memory files from the public HEAD or from public history; the author chose to
# leave those, and deleting from HEAD would not unpublish them anyway.
WORKFLOW_PATHS='^(docs/|handoff/|research_content/|tools/|\.cursor/|\.claude/|scripts/(audit_session|bump-cache-buster|claude-code-sync|commit_msg_bypass|declare_session_scope|gen-hyperliquid-webp|generate-sprint4|migrate_email_domain|pre_commit_staging|push-to-github|remove-meshnet|serve-debug|sprint5-link)|R1_README\.md$|CITATION\.cff$|requirements\.txt$|playwright\.config\.js$|^tests/)'

# DELETIONS ARE ALWAYS ALLOWED, and this is a real fix rather than a convenience.
# The guard exists to stop workflow content ENTERING the site repo; it must never
# stop it LEAVING. Until 2026-08-14 this read the whole staged set, so a `git rm`
# of a blocked path was itself rejected: the guard ENTRENCHED exactly what it was
# built to keep out. Concretely, it would have blocked the author from ever
# removing those 41 memory files from HEAD, which is a live option they are still
# holding. --diff-filter=ACMR keeps Added, Copied, Modified and Renamed (so a
# rename INTO .claude/ is still caught) and drops Deleted.
BLOCKED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$WORKFLOW_PATHS")

if [ -n "$BLOCKED" ]; then
  echo "[pre-commit] ERROR: workflow-content paths staged in site clone." >&2
  echo "[pre-commit] This is the public site clone (~/cryptozach/; CryptoZach/CryptoZach)." >&2
  echo "[pre-commit] Workflow content lives in /Users/zach/Tokenization_Systems_Website/ (CryptoZach/Claude1)." >&2
  echo "[pre-commit] Staged workflow-content paths:" >&2
  echo "$BLOCKED" | sed 's/^/  - /' >&2
  echo "[pre-commit] Switch to workflow clone for these commits." >&2
  case "$BLOCKED" in
    *.claude/memory/*)
      echo "[pre-commit] .claude/memory/ is the AUTO-MEMORY MIRROR and belongs to Claude1 ONLY." >&2
      echo "[pre-commit] Author directive 2026-08-14: it must never reach the public repo." >&2
      echo "[pre-commit] Mirror it in the workflow clone instead: scripts/sync_memory_mirror.sh" >&2
      echo "[pre-commit] (which pushes to origin=Claude1, the private remote, and only there)." >&2
      ;;
  esac
  case "$BLOCKED" in
    *.claude/worktrees/*)
      echo "[pre-commit] .claude/worktrees/ is per-session scratch and belongs in NO repo." >&2
      echo "[pre-commit] Author directive 2026-08-14: keep it out of the public repo." >&2
      echo "[pre-commit] If a worktree got committed as a gitlink, untrack it:" >&2
      echo "[pre-commit]   git rm --cached .claude/worktrees/<id>   (deletions are allowed here)" >&2
      ;;
  esac
  exit 1
fi

# === Editorial guard: no em/en-dashes in newly added prose (CLAUDE.md rule). ===
if [ "${ALLOW_EMDASH:-}" != "1" ]; then
  DASH_FILES=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in .claude/memory/*) continue ;; esac
    if git diff --cached --unified=0 --no-color -- "$f" \
         | grep -E '^\+' | grep -vE '^\+\+\+' | grep -q '[—–]'; then
      DASH_FILES="$DASH_FILES $f"
    fi
  done < <(git diff --cached --name-only --diff-filter=ACM)
  if [ -n "$DASH_FILES" ]; then
    echo "[pre-commit] ERROR: em/en-dash in staged additions; CLAUDE.md forbids them in new prose." >&2
    for f in $DASH_FILES; do echo "  - $f" >&2; done
    echo "[pre-commit] Use comma/parens/colon/period/semicolon. Verbatim-migrated source: ALLOW_EMDASH=1 git commit." >&2
    exit 1
  fi
fi

# staged-vs-committed: a bare `git commit` uses this worktree's shared index, so a
# peer's `git add` between this session's add and this commit is part of the
# commit. `git commit -F <msg> -- <paths>` builds a temporary index
# (next-index-*.lock) and cannot include that peer file.
#
# The message-vs-paths detector was measured on this repo's non-merge history
# (2026-09-21, 988 commits with files): 335 of 685 multi-file commits name at
# least one path and omit another. One confirmed peer sweep sits in that set,
# so precision is 1/335 = 0.003. That detector is not armed. This check refuses
# the form instead, and it does not guess which staged path is the peer.
#
# Stand-down: merge, cherry-pick, revert, and rebase define the index as the
# commit. Measured in scripts/test_shared_index_commit.sh: a file staged before
# git merge stayed staged and was not in the merge commit (1 of 1). Bypass:
# CZ_ALLOW_SHARED_INDEX=1.
if [ "${CZ_ALLOW_SHARED_INDEX:-}" != "1" ]; then
  _gitdir=$(git rev-parse --git-dir)
  case "$_gitdir" in
    /*) ;;
    *) _gitdir="$(pwd)/$_gitdir" ;;
  esac
  _stand=0
  for _m in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    [ -e "$_gitdir/$_m" ] && _stand=1
  done
  [ -d "$_gitdir/rebase-merge" ] && _stand=1
  [ -d "$_gitdir/rebase-apply" ] && _stand=1
  if [ "$_stand" -eq 0 ]; then
    _abs() {
      local d b
      d=$(dirname -- "$1")
      b=$(basename -- "$1")
      printf '%s/%s\n' "$(cd -- "$d" && pwd -P)" "$b"
    }
    _shared=$(_abs "$_gitdir/index")
    _cur=$(_abs "${GIT_INDEX_FILE:-$_gitdir/index}")
    if [ "$_cur" = "$_shared" ]; then
      _n=$(git diff --cached --name-only | grep -c . || true)
      if [ "$_n" -gt 0 ]; then
        echo "[pre-commit] ERROR: staged-vs-committed shared-index commit refused ($_n path(s))." >&2
        echo "[pre-commit] This clone shares one index across sessions. A bare git commit includes a peer's git add." >&2
        echo "[pre-commit] Re-run: git commit -F <message-file> -- <path> [<path> ...]" >&2
        echo "[pre-commit] Deliberate whole-index commit: CZ_ALLOW_SHARED_INDEX=1 git commit ..." >&2
        exit 1
      fi
    fi
  fi
fi

# === Cache-buster: content-hash-derived at build; manual ?v= bump not required. ===
if git diff --cached --name-only --diff-filter=ACM | grep -Fxq 'styles.css'; then
  echo "[pre-commit] FYI: styles.css changed; the cache-buster is derived at build time (content hash), so no manual ?v= bump is needed." >&2
fi

exit 0
